# Phase 1: Core Tools - Environment Variables
# Add these to your .env.local file

# ============================================
# GRAMMAR CHECKER
# ============================================
# Option 1: Use AI Gateway (Kimi/DeepSeek/Gemini)
GRAMMAR_USE_AI_GATEWAY=true

# Option 2: Use dedicated grammar API
# GRAMMAR_API_URL=https://api.grammar-service.com/check

# ============================================
# PARAPHRASE TOOL
# ============================================
# Standalone paraphrase service (recommended for 75% cost savings)
PARAPHRASE_SERVICE_URL=http://localhost:3005
# OR if deployed:
# PARAPHRASE_SERVICE_URL=https://paraphrase.shothik.ai

# Fallback to AI Gateway if standalone fails
PARAPHRASE_FALLBACK_TO_AI_GATEWAY=true

# ============================================
# AI DETECTOR
# ============================================
# ONNX AI Detector service (already in backend-services/)
AI_DETECTOR_URL=http://localhost:3006
# OR if using the Python service directly:
# AI_DETECTOR_URL=http://localhost:8000

# Model path for ONNX
AI_DETECTOR_MODEL_PATH=./models/ai-detector.onnx

# ============================================
# TOOLS API (Unified)
# ============================================
NEXT_PUBLIC_TOOLS_API_URL=/api/tools

# Rate limiting
TOOLS_RATE_LIMIT_PER_MINUTE=60

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_GRAMMAR_CHECKER=true
ENABLE_PARAPHRASE_TOOL=true
ENABLE_AI_DETECTOR=true
ENABLE_TRANSLATOR=false      # Phase 2
ENABLE_HUMANIZE_GPT=false    # Phase 2

# ============================================
# DEBUG
# ============================================
DEBUG_TOOLS=false
