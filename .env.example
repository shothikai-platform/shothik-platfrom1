# Shothik Platform - Environment Variables Template
# Copy this to .env.local and fill in your values

# ============================================
# TIER 1: CRITICAL APIs (Required)
# ============================================

# Kimi AI (Primary LLM)
KIMI_API_KEY=your-kimi-api-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-thinking

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key-here
CLERK_SECRET_KEY=your-clerk-secret-key-here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/register

# Convex Database
CONVEX_DEPLOYMENT=your-deployment-name
CONVEX_URL=https://your-deployment.convex.cloud

# Redis Cache
REDIS_URL=your-redis-url-here

# ============================================
# TIER 2: AI FALLBACKS (Recommended)
# ============================================

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================
# TIER 3: ANIMATION (For Video Generation)
# ============================================

# ElevenLabs (Voice/TTS)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Suno AI (Music)
SUNO_API_KEY=your-suno-api-key-here

# Replicate (Video Models)
REPLICATE_API_TOKEN=your-replicate-token-here

# ============================================
# TIER 4: RESEARCH
# ============================================

# Stitch AI (Memory)
STITCH_API_KEY=your-stitch-api-key-here

# ============================================
# TIER 5: STORAGE
# ============================================

# Cloudflare R2
R2_SECRET_ACCESS_KEY=your-r2-secret-key-here
S3_API_ENDPOINT=your-s3-endpoint-here

# ============================================
# TIER 6: ANALYTICS
# ============================================

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key-here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here

# UptimeRobot
UPTIME_ROBOT_API_KEY=your-uptimerobot-key-here

# ============================================
# TIER 7: STRIPE PAYMENTS
# ============================================

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================
# APP CONFIGURATION
# ============================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_MODE=sandbox

# ============================================
# BACKEND SERVICES
# ============================================

SLIDE_SERVICE_URL=http://localhost:3004
PARAPHRASE_SERVICE_URL=http://localhost:3005
AI_DETECTOR_URL=http://localhost:3006

# ============================================
# FEATURE FLAGS
# ============================================

ENABLE_GRAMMAR_CHECKER=true
ENABLE_PARAPHRASE_TOOL=true
ENABLE_AI_DETECTOR=true
ENABLE_TRANSLATOR=true
ENABLE_HUMANIZE_GPT=true
ENABLE_SUMMARIZER=true
