# Stripe Sandbox Configuration
# Copy this to .env.local for testing

# ============================================
# STRIPE SANDBOX (Test Mode)
# ============================================
# Get these from: https://dashboard.stripe.com/test/apikeys

# Publishable Key (starts with pk_test_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Secret Key (starts with sk_test_)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Webhook Secret (get from stripe CLI or dashboard)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================
# STRIPE CONNECT (Sandbox)
# ============================================
# For author onboarding in test mode

# Connect webhook secret (optional, separate from main)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your_connect_webhook_secret

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_MODE=sandbox

# ============================================
# TEST CREDIT CARDS
# ============================================
# Use these for testing payments:
#
# ✅ Successful payment:
#    Card: 4242 4242 4242 4242
#    Expiry: Any future date
#    CVC: Any 3 digits
#
# ❌ Declined payment:
#    Card: 4000 0000 0000 0002
#
# 🔄 Requires authentication:
#    Card: 4000 0025 0000 3155
#
# 🌐 International (India):
#    Card: 4000 0035 6000 0008
#
# See: https://stripe.com/docs/testing#cards
